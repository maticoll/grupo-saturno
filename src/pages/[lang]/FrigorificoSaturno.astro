---
import SubLandingLayout from '../../layouts/SubLandingLayout.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import ContactoComercial from '../../components/sections/ContactoComercial.astro';
import { getLangFromUrl, useTranslations, languages } from '../../i18n/index';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = JSON.parse(t('saturno.stats')) as Array<{ value: string; label: string }>;
const capacity = JSON.parse(t('saturno.capacity')) as string[];
const cuts = JSON.parse(t('saturno.cuts')) as string[];
const premiumItems = JSON.parse(t('saturno.premiumItems')) as string[];
const storeItems = JSON.parse(t('saturno.storeItems')) as string[];
const pilares = JSON.parse(t('saturno.pilares')) as Array<{ num: string; title: string; desc: string }>;
const adnItems = JSON.parse(t('saturno.adnItems')) as string[];
const cutCategories = JSON.parse(t('product.cutsFullCategories')) as Array<{ title: string; items: string[] }>;
---
<SubLandingLayout
  title={t('meta.saturnoTitle')}
  description={t('meta.saturnoDesc')}
  unitName={t('units.unit2Title')}
>
  <!-- Hero — Frigorífico Saturno -->
  <section class="relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
    <img
      src="/images/planta/planta-exterior-02.jpg"
      alt="Planta industrial Frigorífico Saturno, Ruta 8 Km 38, Empalme Olmos"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-carbon/90 via-carbon/40 to-carbon/10" aria-hidden="true"></div>
    <div class="relative z-10 max-w-[1440px] mx-auto px-8 lg:px-20 pb-16 w-full">
      <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-4 flex items-center gap-3">
        <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
        {t('saturno.heroKicker')}
      </p>
      <h1 class="font-serif text-[clamp(2.5rem,5vw,4.5rem)] font-light leading-[1.0] tracking-[-0.02em] text-white">
        {t('units.unit2Title')}
      </h1>
    </div>
  </section>

  <!-- Presentación -->
  <section class="bg-off-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <SectionLabel class="mb-4">{t('saturno.presentationLabel')}</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-6">
          {t('saturno.presentationH2')}
        </h2>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8] mb-4">
          {t('saturno.presentationBody1')}
        </p>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8]">
          {t('saturno.presentationBody2')}
        </p>
      </div>
      <div class="grid grid-cols-3 gap-2">
        {[
          { src: '/images/planta/planta-exterior-01.jpg', alt: 'Exterior planta Saturno' },
          { src: '/images/planta/planta-exterior-06.jpg', alt: 'Planta Saturno campo' },
          { src: '/images/planta/planta-proceso-01.jpg', alt: 'Proceso interno Saturno' },
        ].map(({ src, alt }) => (
          <div class="h-40 overflow-hidden rounded-sm">
            <img src={src} alt={alt} class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-carbon py-20 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 lg:gap-4">
        {stats.map((stat, i) => {
          const countable = /^\d+[+%]?$/.test(stat.value);
          return (
            <div class="text-center scroll-reveal" style={`transition-delay: ${i * 90}ms`}>
              <p
                class="font-serif text-[clamp(2rem,3vw,3rem)] font-light text-white leading-none mb-2"
                data-count-up={countable ? stat.value : undefined}
              >{stat.value}</p>
              <p class="font-sans text-[0.65rem] tracking-[0.15em] uppercase text-[#aaa]">{stat.label}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Distribución -->
  <section class="bg-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <SectionLabel class="mb-4">{t('saturno.distLabel')}</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-6">
          {t('saturno.distH2')}
        </h2>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8] mb-8">
          {t('saturno.distBody')}
        </p>
        <div class="space-y-4">
          <div class="flex items-start gap-4 border-l-2 border-burgundy pl-4">
            <div>
              <p class="font-sans text-[0.75rem] font-medium tracking-[0.1em] uppercase text-carbon mb-1">{t('saturno.distMetroLabel')}</p>
              <p class="font-sans text-[0.8rem] font-light text-[#555]">{t('saturno.distMetroFreq')}</p>
            </div>
          </div>
          <div class="flex items-start gap-4 border-l-2 border-[#c8a87a] pl-4">
            <div>
              <p class="font-sans text-[0.75rem] font-medium tracking-[0.1em] uppercase text-carbon mb-1">{t('saturno.distInteriorLabel')}</p>
              <p class="font-sans text-[0.8rem] font-light text-[#555]">
                {t('saturno.distInteriorDepts')}
              </p>
              <p class="font-sans text-[0.75rem] font-light text-[#888] mt-1">{t('saturno.distInteriorFreq')}</p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-off-white rounded-sm p-8">
        <p class="font-sans text-[0.65rem] tracking-[0.18em] uppercase text-[#888] mb-6">{t('saturno.capacityLabel')}</p>
        <ul class="space-y-5">
          {capacity.map(item => (
            <li class="flex items-start gap-3">
              <span class="w-1 h-1 rounded-full bg-burgundy mt-[0.45rem] shrink-0" aria-hidden="true"></span>
              <span class="font-sans text-[0.82rem] font-light text-[#444] leading-[1.7]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Líneas de producto -->
  <section class="bg-off-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <div class="mb-14">
        <SectionLabel class="mb-4">{t('saturno.productLabel')}</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon">
          {t('saturno.productH2')}
        </h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Columna izquierda: Una Línea de Excelencia (info) + Premium Store -->
        <div class="flex flex-col gap-8">
          <!-- Saturno Premium — descripción + ítems -->
          <div class="bg-white p-10 border-t-2 border-burgundy">
            <p class="font-sans text-[0.65rem] tracking-[0.18em] uppercase text-burgundy mb-4">{t('saturno.premiumLabel')}</p>
            <h3 class="font-serif text-[1.4rem] font-light text-carbon mb-4">{t('saturno.premiumH3')}</h3>
            <p class="font-sans text-[0.82rem] font-light text-[#555] leading-[1.8] mb-6">
              {t('saturno.premiumBody')}
            </p>
            <ul class="space-y-3">
              {premiumItems.map(item => (
                <li class="flex items-start gap-3">
                  <span class="w-1 h-1 rounded-full bg-burgundy mt-[0.45rem] shrink-0" aria-hidden="true"></span>
                  <span class="font-sans text-[0.8rem] font-light text-[#555] leading-[1.7]">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <!-- Premium Store -->
          <div class="bg-white p-10 border-t-2 border-[#c8a87a]">
            <p class="font-sans text-[0.65rem] tracking-[0.18em] uppercase text-[#8a6a3a] mb-4">{t('saturno.storeLabel')}</p>
            <h3 class="font-serif text-[1.4rem] font-light text-carbon mb-4">{t('saturno.storeH3')}</h3>
            <p class="font-sans text-[0.82rem] font-light text-[#555] leading-[1.8] mb-6">
              {t('saturno.storeBody')}
            </p>
            <ul class="space-y-3">
              {storeItems.map(item => (
                <li class="flex items-start gap-3">
                  <span class="w-1 h-1 rounded-full bg-[#c8a87a] mt-[0.45rem] shrink-0" aria-hidden="true"></span>
                  <span class="font-sans text-[0.8rem] font-light text-[#555] leading-[1.7]">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <!-- Columna derecha: cortes + vaca -->
        <div class="bg-white p-10 border-t-2 border-burgundy">
          <div class="grid grid-cols-2 gap-1 mb-6" id="saturno-cuts-list">
            {cuts.map((corte, i) => (
              <p
                class="sc-cut font-sans text-[0.72rem] text-[#555] py-1 border-b border-[#eee] transition-all duration-200 cursor-default rounded-sm"
                data-cut-idx={i}
              >{corte}</p>
            ))}
          </div>
          <div class="relative w-full" id="cow-hotmap">
            <img
              src="/images/cortes-vaca-1.png"
              alt="Diagrama de cortes de la vaca — Frigorífico Saturno"
              class="select-none"
              loading="lazy"
              decoding="async"
            />
            <!-- SVG overlay — viewBox coincide con dimensiones reales de la imagen (1448×1086) -->
            <svg
              class="absolute inset-0 w-full h-full"
              viewBox="0 0 1448 1086"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <!-- Zona 4 → Bife Ancho (idx 0) -->
              <polygon class="sc-zone" data-cuts="0" data-image="/images/cut-4.png"
                points="488,168 757,168 757,370 488,370" />
              <!-- Zona 5 → Bife Angosto (idx 1) -->
              <polygon class="sc-zone" data-cuts="1" data-image="/images/cut-5.png"
                points="778,168 882,168 882,340 778,340" />
              <!-- Zona 6 → Lomo (idx 2) -->
              <polygon class="sc-zone" data-cuts="2" data-image="/images/cut-6.png"
                points="883,163 973,163 973,310 883,310" />
              <!-- Zona 7 → Cuadril + Colita de cuadril (idx 3,4) -->
              <polygon class="sc-zone" data-cuts="3,4" data-image="/images/cut-7.png"
                points="954,138 1195,138 1195,345 954,345" />
              <!-- Zona 11 → Vacío (idx 5) -->
              <polygon class="sc-zone" data-cuts="5" data-image="/images/cut-11.png"
                points="840,533 1080,533 1080,688 840,688" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Listado completo de cortes INAC (acordeón) -->
      <div class="bg-burgundy/10 mt-8" x-data="{ open: false, cat: null }">
        <button
          type="button"
          @click="open = !open"
          :aria-expanded="open"
          class="w-full bg-white px-9 py-6 min-h-[44px] flex items-center justify-between gap-4 text-left cursor-pointer"
        >
          <h3 class="font-serif text-[1.3rem] font-medium text-carbon">{t('product.cutsFullToggle')}</h3>
          <svg class="w-5 h-5 text-burgundy shrink-0 transition-transform duration-300" :class="open && 'rotate-180'"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div x-show="open" x-cloak class="border-t border-burgundy/10">
          <div class="grid grid-cols-1 gap-px bg-burgundy/10">
            {cutCategories.map((category, i) => (
              <div class="bg-white">
                <button
                  type="button"
                  @click={`cat = cat === ${i} ? null : ${i}`}
                  :aria-expanded={`cat === ${i}`}
                  class="w-full px-9 py-4 min-h-[44px] flex items-center justify-between gap-4 text-left cursor-pointer"
                >
                  <span class="font-serif text-[1.05rem] font-medium text-carbon">{category.title}</span>
                  <span class="flex items-center gap-3 shrink-0">
                    <span class="font-sans text-[0.7rem] text-warm-gray">{category.items.length} {t('product.cutsFullCountLabel')}</span>
                    <svg class="w-4 h-4 text-burgundy transition-transform duration-300" :class={`cat === ${i} && 'rotate-180'`}
                      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                  </span>
                </button>
                <ul x-show={`cat === ${i}`} x-cloak class="px-9 pb-6 columns-1 sm:columns-2 lg:columns-3 gap-x-10">
                  {category.items.map((item) => (
                    <li class="font-sans text-[0.82rem] font-light text-[#555] leading-[1.6] py-1.5 break-inside-avoid border-b border-burgundy/5">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="bg-white px-9 py-4 font-sans text-[0.65rem] tracking-[0.05em] text-warm-gray border-t border-burgundy/10">
            {t('product.cutsFullSource')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pilares estratégicos -->
  <section class="bg-carbon py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <div class="mb-14">
        <SectionLabel class="mb-4">{t('saturno.pilaresLabel')}</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-white">
          {t('saturno.pilaresH2')}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {pilares.map((pilar, i) => (
          <div
            class="pilar-card border border-white/10 p-8 hover:border-burgundy/60 transition-colors duration-300"
            style={`animation-delay: ${i * 110}ms`}
          >
            <p class="font-sans text-[0.65rem] tracking-[0.18em] uppercase text-burgundy mb-4">{pilar.num}</p>
            <h3 class="font-serif text-[1.1rem] font-light text-white mb-3">{pilar.title}</h3>
            <p class="font-sans text-[0.8rem] font-light text-[#aaa] leading-[1.7]">{pilar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ADN Uruguayo -->
  <section class="bg-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionLabel class="mb-4">{t('saturno.identityLabel')}</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-6">
          {t('saturno.identityH2')}
        </h2>
        <p class="adn-para font-sans text-[0.85rem] font-light text-[#555] leading-[1.8] mb-6" style="animation-delay:0ms">
          {t('saturno.identityBody1')}
        </p>
        <p class="adn-para font-sans text-[0.85rem] font-light text-[#555] leading-[1.8]" style="animation-delay:220ms">
          {t('saturno.identityBody2')}
        </p>
        <p class="adn-quote font-serif text-[1rem] font-light text-carbon tracking-[0.04em] italic text-center mt-10">
          {t('saturno.identityQuote')}
        </p>
      </div>
      <div class="space-y-4">
        {adnItems.map((item, i) => (
          <div
            class="adn-item flex items-center gap-4 py-4 border-b border-[#eee]"
            style={`animation-delay:${i * 80}ms`}
          >
            <span class="w-2 h-2 rounded-full bg-burgundy shrink-0" aria-hidden="true"></span>
            <span class="font-sans text-[0.82rem] font-light text-[#444]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section class="bg-off-white py-16 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border border-[#ddd] p-10">
      <div>
        <p class="font-sans text-[0.65rem] tracking-[0.18em] uppercase text-[#888] mb-2">{t('saturno.contactLabel')}</p>
        <p class="font-serif text-[1.2rem] font-light text-carbon">{t('saturno.contactName')}</p>
        <p class="font-sans text-[0.82rem] font-light text-[#555] mt-1">{t('saturno.contactAddr')}</p>
      </div>
      <div class="flex flex-col sm:items-end gap-2">
        <a href="tel:+59822956494" class="font-sans text-[0.82rem] font-light text-carbon hover:text-burgundy transition-colors">+598 2295 6494</a>
        <a href="mailto:administracion@frigorificosaturno.com" class="font-sans text-[0.82rem] font-light text-carbon hover:text-burgundy transition-colors">administracion@frigorificosaturno.com</a>
      </div>
    </div>
  </section>

  <ContactoComercial />
</SubLandingLayout>

<style is:global>
  [x-cloak] { display: none !important; }
  .sc-zone {
    cursor: pointer;
    fill: transparent;
    stroke: none;
  }
  #cow-hotmap {
    padding-bottom: 75%; /* 1086/1448 ≈ 75% — fija la altura relativa al ancho */
    height: 0;
  }
  #cow-hotmap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .sc-cut.sc-active {
    color: #6B2E2A !important;
    font-weight: 600;
    background-color: rgba(107, 46, 42, 0.07);
    padding-left: 4px;
    padding-right: 4px;
  }

  /* Pilares — animación de caída */
  @keyframes pilarFall {
    from {
      opacity: 0;
      transform: translateY(-42px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pilar-card {
    opacity: 0;
  }

  .pilar-card.is-visible {
    animation: pilarFall 1.05s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  /* ADN — párrafos (reutiliza pilarFall) */
  .adn-para { opacity: 0; }
  .adn-para.is-visible {
    animation: pilarFall 1.05s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  /* ADN — ítems slide desde la derecha */
  @keyframes adnSlideIn {
    from { opacity: 0; transform: translateX(52px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .adn-item { opacity: 0; }
  .adn-item.is-visible {
    animation: adnSlideIn 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  /* ADN — quote typewriter */
  .adn-quote { opacity: 0; }
  .adn-quote.is-typing { opacity: 1; }
</style>

<script>
  const zones = document.querySelectorAll<HTMLElement>('.sc-zone');
  const cutItems = document.querySelectorAll<HTMLElement>('.sc-cut');
  const cowImg = document.querySelector<HTMLImageElement>('#cow-hotmap img');
  const cowBaseSrc = cowImg?.src ?? '';

  // Mapa idx → imagen (generado desde data-image de cada zona)
  const idxToImage = new Map<number, string>();
  zones.forEach(zone => {
    const img = zone.dataset.image;
    if (!img) return;
    (zone.dataset.cuts ?? '').split(',').map(Number).forEach(i => idxToImage.set(i, img));
  });

  function setActive(indices: number[], on: boolean) {
    indices.forEach(i => cutItems[i]?.classList.toggle('sc-active', on));
  }

  function swapCowImage(indices: number[], on: boolean) {
    if (!cowImg) return;
    if (on) {
      // Usa la imagen del primer índice que tenga una asignada
      const img = indices.map(i => idxToImage.get(i)).find(Boolean);
      if (img) cowImg.src = img;
    } else {
      cowImg.src = cowBaseSrc;
    }
  }

  zones.forEach(zone => {
    const indices = (zone.dataset.cuts ?? '').split(',').map(Number);
    zone.addEventListener('mouseenter', () => {
      setActive(indices, true);
      swapCowImage(indices, true);
    });
    zone.addEventListener('mouseleave', () => {
      setActive(indices, false);
      swapCowImage(indices, false);
    });
  });

  cutItems.forEach(item => {
    const idx = Number(item.dataset.cutIdx);
    item.addEventListener('mouseenter', () => {
      item.classList.add('sc-active');
      zones.forEach(zone => {
        const zoneIndices = (zone.dataset.cuts ?? '').split(',').map(Number);
        if (zoneIndices.includes(idx)) zone.classList.add('sc-active');
      });
      swapCowImage([idx], true);
    });
    item.addEventListener('mouseleave', () => {
      item.classList.remove('sc-active');
      zones.forEach(zone => zone.classList.remove('sc-active'));
      swapCowImage([idx], false);
    });
  });

  // Pilares — animación scroll
  const pilarCards = document.querySelectorAll('.pilar-card');
  const pilarObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          pilarObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  pilarCards.forEach(card => pilarObserver.observe(card));

  // ADN — párrafos (caída escalonada)
  const adnParas = document.querySelectorAll<HTMLElement>('.adn-para');
  const adnParaObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        adnParaObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  adnParas.forEach(p => adnParaObs.observe(p));

  // ADN — ítems (slide desde la derecha)
  const adnItems = document.querySelectorAll<HTMLElement>('.adn-item');
  const adnItemObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        adnItemObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });
  adnItems.forEach(item => adnItemObs.observe(item));

  // ADN — quote typewriter
  const adnQuote = document.querySelector<HTMLElement>('.adn-quote');
  if (adnQuote) {
    const fullText = adnQuote.textContent?.trim() ?? '';
    adnQuote.textContent = '';
    let typed = false;
    const quoteObs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && !typed) {
          typed = true;
          adnQuote.classList.add('is-typing');
          quoteObs.unobserve(e.target);
          let i = 0;
          const tick = () => {
            if (i < fullText.length) {
              adnQuote.textContent += fullText[i++];
              setTimeout(tick, 70);
            }
          };
          tick();
        }
      });
    }, { threshold: 0.6 });
    quoteObs.observe(adnQuote);
  }
</script>
