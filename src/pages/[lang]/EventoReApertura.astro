---
import SubLandingLayout from '../../layouts/SubLandingLayout.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import ContactoComercial from '../../components/sections/ContactoComercial.astro';
import { getLangFromUrl, useTranslations, languages } from '../../i18n/index';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fotosDestacadas = [
  { src: '/images/fotos/intendente-presidente-luis.jpeg',       alt: 'Intendente de Florida, Presidente y Luis — reapertura 2026' },
  { src: '/images/fotos/luis-entrevistado.jpeg',                alt: 'Luis entrevistado — reapertura Establecimiento Florida' },
  { src: '/images/fotos/presidente-con-luis-y-paula.jpeg',      alt: 'Presidente con Luis y Paula — Grupo Saturno' },
  { src: '/images/fotos/luis-hablando.jpeg',                    alt: 'Luis hablando — ceremonia reapertura' },
  { src: '/images/fotos/presidente-hablando.jpeg',              alt: 'Presidente hablando — acto oficial' },
  { src: '/images/fotos/presidente-y-equipo-saturno.jpeg',      alt: 'Presidente y equipo Saturno' },
  { src: '/images/fotos/presidente-y-luis.jpeg',                alt: 'Presidente y Luis — Establecimiento Florida' },
];

// Imágenes intercaladas por número para evitar fotos similares contiguas
const fotosMarqueeRow1 = [
  { src: '/images/fotos/FLORIDA-07.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-38.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-45.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-54.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-62.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-68.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-71.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-74.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-77.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-096.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-134.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-156.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-161.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
];

const fotosMarqueeRow2 = [
  { src: '/images/fotos/FLORIDA-08.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-39.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-48.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-58.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-63.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-69.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-72.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-75.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-79.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-107.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-141.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-158.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-169.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
];

const fotosMarqueeRow3 = [
  { src: '/images/fotos/FLORIDA-34.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-41.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-51.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-59.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-66.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-70.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-73.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-76.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-85.jpg',  alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-119.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-155.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
  { src: '/images/fotos/FLORIDA-159.jpg', alt: 'Reapertura Florida — Grupo Saturno' },
];
---
<SubLandingLayout
  title={t('meta.reoaberturaTitle')}
  description={t('meta.reoaberturaDesc')}
  image="/images/reapertura/reapertura-exterior-01.jpg"
  unitName={t('reapertura.unitName')}
>

  <!-- JSON-LD Event -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "Reapertura Establecimiento Florida 365 — Grupo Saturno",
    "startDate": "2026-04-16",
    "location": {
      "@type": "Place",
      "name": "Establecimiento Florida 365",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Florida",
        "addressRegion": "Florida",
        "addressCountry": "UY"
      }
    },
    "organizer": {
      "@type": "Organization",
      "name": "Grupo Saturno",
      "url": "https://gruposaturno.com.uy"
    },
    "description": "Ceremonia de reapertura del Establecimiento Florida de Grupo Saturno, con presencia de autoridades departamentales y nacionales."
  }).replace(/<\//g, '<\\/')} />

  <!-- Hero -->
  <section class="relative h-[85vh] min-h-[560px] flex items-end overflow-hidden">
    <img
      src="/images/reapertura/florida-136.jpg"
      alt="Establecimiento Florida — reapertura abril 2026"
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-carbon/90 via-carbon/40 to-carbon/10" aria-hidden="true"></div>
    <div class="relative z-10 max-w-[1440px] mx-auto px-8 lg:px-20 pb-16 w-full">
      <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-4 flex items-center gap-3">
        <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
        {t('reapertura.kicker')}
      </p>
      <h1 class="font-serif text-[clamp(2rem,4.5vw,4rem)] font-light leading-[1.0] tracking-[-0.02em] text-white">
        {t('reapertura.h1')}
      </h1>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-off-white py-20 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7">
        <SectionLabel class="mb-4">{t('reapertura.label')}</SectionLabel>
        <p class="font-sans text-[0.88rem] font-light text-[#555] leading-[1.85] max-w-xl">
          {t('reapertura.lead')}
        </p>
      </div>
      <div class="lg:col-span-5 flex flex-col justify-center gap-4">
        <div class="border-l-2 border-burgundy pl-5">
          <p class="font-sans text-[0.62rem] tracking-[0.18em] uppercase text-burgundy mb-1">{t('reapertura.dateLabel')}</p>
          <p class="font-sans text-[0.85rem] text-carbon font-light">{t('reapertura.date')}</p>
        </div>
        <div class="border-l-2 border-burgundy/30 pl-5">
          <p class="font-sans text-[0.62rem] tracking-[0.18em] uppercase text-burgundy mb-1">{t('reapertura.placeLabel')}</p>
          <p class="font-sans text-[0.85rem] text-carbon font-light">{t('reapertura.place')}</p>
        </div>
        <div class="border-l-2 border-burgundy/30 pl-5">
          <p class="font-sans text-[0.62rem] tracking-[0.18em] uppercase text-burgundy mb-1">{t('reapertura.organizerLabel')}</p>
          <p class="font-sans text-[0.85rem] text-carbon font-light">{t('reapertura.organizer')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Galería destacada -->
  <section class="bg-carbon pt-10 pb-6 px-1">
    <div class="max-w-[1440px] mx-auto mb-6 px-8 lg:px-20">
      <SectionLabel class="text-white/60 mb-2">{t('reapertura.galleryLabel')}</SectionLabel>
    </div>
    <!-- Grid editorial responsive -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1 px-1">

      <!-- Fila 1: presidente hablando (2/3) + intendente+presidente+luis (1/3) -->
      <div class="col-span-1 sm:col-span-2 lg:col-span-2 h-64 sm:h-80 lg:h-[480px] overflow-hidden group">
        <img src={fotosDestacadas[4].src} alt={fotosDestacadas[4].alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="eager" />
      </div>
      <div class="col-span-1 h-64 sm:h-80 lg:h-[480px] overflow-hidden group">
        <img src={fotosDestacadas[0].src} alt={fotosDestacadas[0].alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="eager" />
      </div>

      <!-- Fila 2: tres iguales — presidente+luis+paula / luis hablando / luis entrevistado -->
      <div class="col-span-1 h-56 sm:h-64 lg:h-[320px] overflow-hidden group">
        <img src={fotosDestacadas[2].src} alt={fotosDestacadas[2].alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
      </div>
      <div class="col-span-1 h-56 sm:h-64 lg:h-[320px] overflow-hidden group">
        <img src={fotosDestacadas[3].src} alt={fotosDestacadas[3].alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
      </div>
      <div class="col-span-1 h-56 sm:h-64 lg:h-[320px] overflow-hidden group">
        <img src={fotosDestacadas[1].src} alt={fotosDestacadas[1].alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
      </div>

      <!-- Fila 3: presidente+equipo (1/3) + presidente y luis (2/3) -->
      <div class="col-span-1 h-64 sm:h-72 lg:h-[400px] overflow-hidden group">
        <img src={fotosDestacadas[5].src} alt={fotosDestacadas[5].alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
      </div>
      <div class="col-span-1 sm:col-span-2 lg:col-span-2 h-64 sm:h-72 lg:h-[400px] overflow-hidden group">
        <img src={fotosDestacadas[6].src} alt={fotosDestacadas[6].alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
      </div>

    </div>
  </section>

  <!-- Marquee galería -->
  <section class="bg-carbon pb-10 overflow-hidden">
    <div class="flex flex-col gap-1">

      <!-- Fila 1: izquierda → -->
      <div class="flex gap-1 marquee-left">
        <div class="flex gap-1 shrink-0 marquee-track">
          {[...fotosMarqueeRow1, ...fotosMarqueeRow1].map(({ src, alt }) => (
            <div class="w-64 h-44 shrink-0 overflow-hidden">
              <img src={src} alt={alt} class="w-full h-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      </div>

      <!-- Fila 2: derecha ← -->
      <div class="flex gap-1 marquee-right">
        <div class="flex gap-1 shrink-0 marquee-track">
          {[...fotosMarqueeRow2, ...fotosMarqueeRow2].map(({ src, alt }) => (
            <div class="w-64 h-44 shrink-0 overflow-hidden">
              <img src={src} alt={alt} class="w-full h-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      </div>

      <!-- Fila 3: izquierda → -->
      <div class="flex gap-1 marquee-left">
        <div class="flex gap-1 shrink-0 marquee-track">
          {[...fotosMarqueeRow3, ...fotosMarqueeRow3].map(({ src, alt }) => (
            <div class="w-64 h-44 shrink-0 overflow-hidden">
              <img src={src} alt={alt} class="w-full h-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <style>
    .marquee-left  { display: flex; }
    .marquee-right { display: flex; }

    .marquee-left .marquee-track {
      animation: scroll-left 30s linear infinite;
    }
    .marquee-right .marquee-track {
      animation: scroll-right 30s linear infinite;
    }

    @keyframes scroll-left {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    @keyframes scroll-right {
      from { transform: translateX(-50%); }
      to   { transform: translateX(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee-left .marquee-track,
      .marquee-right .marquee-track { animation: none; }
    }
  </style>

  <!-- Volver + CTA -->
  <section class="bg-off-white py-20 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
      <a
        href={`/${lang}/EstablecimientoFlorida`}
        class="font-sans text-[0.72rem] tracking-[0.12em] uppercase text-burgundy hover:underline flex items-center gap-2"
      >
        {t('reapertura.backLink')}
      </a>
      <div class="max-w-md">
        <h2 class="font-serif text-[1.4rem] font-light text-carbon mb-3 tracking-[-0.02em]">
          {t('reapertura.ctaTitle')}
        </h2>
        <p class="font-sans text-[0.78rem] font-light text-[#666] leading-[1.7] mb-5">
          {t('reapertura.ctaText')}
        </p>
        <a
          href={`/${lang}/EstablecimientoFlorida`}
          class="inline-flex items-center gap-2 font-sans text-[0.68rem] tracking-[0.12em] uppercase bg-burgundy text-white px-6 py-3 hover:bg-burgundy/90 transition-colors"
        >
          {t('reapertura.ctaButton')} →
        </a>
      </div>
    </div>
  </section>

  <ContactoComercial />

</SubLandingLayout>
