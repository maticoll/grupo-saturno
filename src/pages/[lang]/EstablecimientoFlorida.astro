---
import SubLandingLayout from '../../layouts/SubLandingLayout.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import ContactoComercial from '../../components/sections/ContactoComercial.astro';
import { getLangFromUrl, useTranslations, languages } from '../../i18n/index';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { label: t('florida.stat1Label'), value: t('florida.stat1Value') },
  { label: t('florida.stat2Label'), value: t('florida.stat2Value') },
  { label: t('florida.stat4Label'), value: t('florida.stat4Value') },
];

const markets = JSON.parse(t('florida.markets')) as Array<{
  flag: string; name: string; cert: string; stat: string; text: string;
}>;
---
<SubLandingLayout
  title={t('meta.floridaTitle')}
  description={t('meta.floridaDesc')}
  image="/images/florida-exterior-principal.jpg"
  unitName={t('units.unit1Title')}
>

  <!-- JSON-LD FoodEstablishment -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FoodEstablishment",
    "name": "Establecimiento Florida 365 — Establecimiento 365",
    "parentOrganization": { "@type": "Organization", "name": "Grupo Saturno" },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Florida",
      "addressRegion": "Florida",
      "addressCountry": "UY"
    },
    "description": "Planta frigorífica especializada en procesamiento y exportación de carne vacuna de calidad premium. Unidad 01 de Grupo Saturno.",
    "url": "https://gruposaturno.com.uy/es/EstablecimientoFlorida"
  }).replace(/<\//g, '<\\/')} />

  <!-- Hero -->
  <section class="relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
    <img
      src="/images/florida-exterior-principal.jpg"
      alt="Establecimiento Florida 365, Grupo Saturno — Florida, Uruguay"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-carbon/90 via-carbon/40 to-carbon/10" aria-hidden="true"></div>
    <div class="relative z-10 max-w-[1440px] mx-auto px-8 lg:px-20 pb-16 w-full">
      <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-4 flex items-center gap-3">
        <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
        {t('florida.heroKicker')}
      </p>
      <h1 class="font-serif text-[clamp(2.5rem,5vw,4.5rem)] font-light leading-[1.0] tracking-[-0.02em] text-white">
        {t('units.unit1Title')}
      </h1>
      <p class="mt-4 font-sans text-[0.8rem] font-light text-white/60 max-w-lg leading-[1.75]">
        {t('florida.heroDesc')}
      </p>
    </div>
  </section>

  <!-- Capacidades -->
  <section class="bg-off-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <SectionLabel class="mb-4">{t('florida.presentationLabel')}</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-6">
          {t('florida.presentationH2')}
        </h2>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8]">
          {t('florida.presentationBody')}
        </p>
        <div class="mt-10 grid grid-cols-3 gap-px bg-burgundy/10">
          {stats.map(({ label, value }) => (
            <div class="bg-off-white p-5">
              <p class="font-sans text-[0.58rem] tracking-[0.18em] uppercase text-burgundy mb-1">{label}</p>
              <p class="font-sans text-[0.82rem] font-medium text-carbon">{value}</p>
            </div>
          ))}
        </div>
        <div class="mt-2 overflow-hidden">
          <img
            src="/images/florida-entrada.jpg"
            alt="Entrada Establecimiento Florida — Grupo Saturno, Florida, Uruguay"
            class="w-full aspect-[16/9] object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <div class="overflow-hidden">
          <img
            src="/images/linea-procesado-2.jpg"
            alt="Línea de procesado — Establecimiento Florida 365, Grupo Saturno"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="overflow-hidden">
          <img
            src="/images/fotos/IMG_9407.jpeg"
            alt="Cortes vacunos al vacío — Establecimiento Florida 365, Grupo Saturno"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Mapa exportaciones -->
  <section class="bg-white pt-16 pb-0 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <img
        src="/images/mapa-saturno-exportaciones.png"
        alt="Mapa de exportaciones — Grupo Saturno"
        class="w-full h-auto"
        loading="lazy"
      />
      <p class="font-serif text-[0.8rem] tracking-[0.08em] text-carbon/60 mt-2 italic">{t('common.mapCaption')}</p>
    </div>
  </section>

  <!-- Tres mercados -->
  <section class="bg-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-4 flex items-center gap-3">
        <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
        {t('florida.marketsLabel')}
      </p>
      <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-12">
        {t('florida.marketsH2')}<br /><em class="italic text-carbon/60">{t('florida.marketsH2Italic')}</em>
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-burgundy/10">
        {markets.map(({ flag, name, cert, stat, text }) => (
          <div class="bg-white p-8 lg:p-10">
            <p class="text-3xl mb-4">{flag}</p>
            <p class="font-sans text-[0.58rem] tracking-[0.18em] uppercase text-burgundy mb-1">{cert}</p>
            <h3 class="font-serif text-[1.4rem] font-light text-carbon mb-1">{name}</h3>
            <p class="font-sans text-[0.68rem] font-medium text-burgundy mb-4">{stat}</p>
            <p class="font-sans text-[0.8rem] font-light text-[#555] leading-[1.75]">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fotos + Brochure -->
  <section class="bg-off-white py-20 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-10">
        <div class="overflow-hidden">
          <img
            src="/images/fotos/stand-china.jpeg"
            alt="Stand China — Establecimiento Florida 365, Grupo Saturno"
            class="w-full h-[480px] object-cover object-top hover:scale-[1.03] transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="relative overflow-hidden">
          <img
            src="/images/fotos/florida-y-cma.jpeg"
            alt="Florida y CMA"
            class="w-full h-[480px] object-cover object-top hover:scale-[1.03] transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/70 to-transparent pointer-events-none"></div>
          <p class="absolute bottom-4 left-5 font-serif text-[0.85rem] tracking-[0.1em] uppercase text-white/90">{t('common.floridaCmaCaption')}</p>
        </div>
      </div>
      <div>
        <a
          href="/brochure.pdf"
          download
          class="inline-flex items-center gap-2 font-sans text-[0.7rem] tracking-[0.12em] uppercase bg-burgundy text-white px-6 py-3 hover:bg-burgundy/90 transition-colors"
        >
          {t('common.downloadBrochure')}
        </a>
      </div>
    </div>
  </section>

  <!-- Teaser Evento Reapertura -->
  <section class="bg-carbon py-20 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative h-72 lg:h-auto overflow-hidden">
          <img
            src="/images/fotos/establecimiento-florida.jpeg"
            alt="Establecimiento Florida 365 — Grupo Saturno"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-transparent to-carbon/60 hidden lg:block"></div>
        </div>
        <div class="bg-[#0e1215] p-10 lg:p-16 flex flex-col justify-center">
          <p class="font-sans text-[0.58rem] tracking-[0.25em] uppercase text-burgundy mb-4 flex items-center gap-3">
            <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
            {t('florida.teaserLabel')}
          </p>
          <h2 class="font-serif text-[clamp(1.6rem,2.2vw,2.2rem)] font-light text-white leading-[1.1] tracking-[-0.02em] mb-5">
            {t('florida.teaserH2')}<br /><em class="italic text-white/70">{t('florida.teaserH2Italic')}</em>
          </h2>
          <p class="font-sans text-[0.78rem] font-light text-white/50 leading-[1.75] mb-8 max-w-sm">
            {t('florida.teaserBody')}
          </p>
          <a
            href={`/${lang}/EventoReApertura`}
            class="inline-flex items-center gap-3 font-sans text-[0.68rem] tracking-[0.12em] uppercase text-white/70 border border-white/20 px-6 py-3 w-fit hover:text-white hover:border-white/50 hover:bg-burgundy/30 transition-all duration-200"
          >
            {t('florida.teaserCta')} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactoComercial />

</SubLandingLayout>
