---
import SubLandingLayout from '../../layouts/SubLandingLayout.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import ContactoComercial from '../../components/sections/ContactoComercial.astro';
import { getLangFromUrl, useTranslations, languages } from '../../i18n/index';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<SubLandingLayout
  title={t('meta.floridaTitle')}
  description={t('meta.floridaDesc')}
  image="/images/florida/florida-exterior-01.jpg"
  unitName="Frigorífico Florida"
>

  <!-- JSON-LD FoodEstablishment -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FoodEstablishment",
    "name": "Frigorífico Florida — Establecimiento 365",
    "parentOrganization": { "@type": "Organization", "name": "Grupo Saturno" },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Florida",
      "addressRegion": "Florida",
      "addressCountry": "UY"
    },
    "description": "Planta frigorífica especializada en procesamiento y exportación de carne vacuna de calidad premium. Unidad 01 de Grupo Saturno.",
    "url": "https://gruposaturno.com.uy/es/FrigorificoFlorida"
  }).replace(/<\//g, '<\\/')} />

  <!-- Hero -->
  <section class="relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
    <img
      src="/images/florida/florida-hero.jpg"
      alt="Ceremonia de reapertura Establecimiento Florida, Grupo Saturno"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-carbon/90 via-carbon/40 to-carbon/10" aria-hidden="true"></div>
    <div class="relative z-10 max-w-[1440px] mx-auto px-8 lg:px-20 pb-16 w-full">
      <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-4 flex items-center gap-3">
        <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
        Unidad 01 · Grupo Saturno
      </p>
      <h1 class="font-serif text-[clamp(2.5rem,5vw,4.5rem)] font-light leading-[1.0] tracking-[-0.02em] text-white">
        Frigorífico Florida
      </h1>
      <p class="mt-4 font-sans text-[0.8rem] font-light text-white/60 max-w-lg leading-[1.75]">
        Establecimiento especializado en procesamiento y exportación de carne vacuna. Florida, Uruguay.
      </p>
    </div>
  </section>

  <!-- Capacidades -->
  <section class="bg-off-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <SectionLabel class="mb-4">Establecimiento Florida 365</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-6">
          Planta de faena y exportación propia
        </h2>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8] mb-4">
          El Establecimiento Florida 365 es la planta de faena del Grupo Saturno: el eslabón que cierra la cadena de valor y habilita la exportación directa al mercado internacional. Adquirida en 2025 y reinaugurada en marzo de 2026, opera con capacidad para procesar hasta 300 vacunos por día.
        </p>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8]">
          En 2024, bajo gestión anterior, el establecimiento ya exportó <strong class="font-medium text-carbon">US$ 6,26 millones</strong>, con China como destino principal del 84% del volumen. Bajo la dirección del Grupo Saturno, la proyección es significativamente mayor.
        </p>
        <div class="mt-10 grid grid-cols-2 gap-px bg-burgundy/10">
          {[
            { label: 'Departamento', value: 'Florida, Uruguay' },
            { label: 'Capacidad', value: '300 vacunos / día' },
            { label: 'Empleos directos', value: '+100 trabajadores' },
            { label: 'Exportaciones 2024', value: 'US$ 6,26 millones' },
          ].map(({ label, value }) => (
            <div class="bg-off-white p-5">
              <p class="font-sans text-[0.58rem] tracking-[0.18em] uppercase text-burgundy mb-1">{label}</p>
              <p class="font-sans text-[0.82rem] font-medium text-carbon">{value}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-1 gap-2">
        <div class="aspect-[16/9] overflow-hidden">
          <img
            src="/images/florida/florida-exterior-01.jpg"
            alt="Fachada Establecimiento Florida — Grupo Saturno, Florida, Uruguay"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/florida/florida-proceso-01.jpg"
              alt="Proceso interno Frigorífico Florida"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/florida/florida-producto-01.jpg"
              alt="Producto Frigorífico Florida — cortes vacunos premium"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mercados de exportación -->
  <section class="bg-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <div class="mb-14">
        <SectionLabel class="mb-4">Habilitaciones vigentes</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon">
          Tres mercados. Tres estándares. Un solo proveedor.
        </h2>
        <p class="mt-4 font-sans text-[0.85rem] font-light text-[#555] leading-[1.8] max-w-2xl">
          El Establecimiento Florida 365 cuenta con habilitaciones de exportación para los tres bloques de mayor demanda y mayor exigencia sanitaria del mundo. Cumplir los tres a la vez no es común — es una ventaja competitiva real para el importador.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-burgundy/10">
        <div class="bg-white p-10 border-t-2 border-burgundy">
          <p class="font-sans text-[0.58rem] tracking-[0.22em] uppercase text-burgundy mb-4">Mercado 01</p>
          <h3 class="font-serif text-[1.4rem] font-light text-carbon mb-3">China</h3>
          <p class="font-sans text-[0.78rem] font-light text-[#555] leading-[1.8] mb-4">
            Registro activo ante la Administración General de Aduanas de China (GACC). Principal destino de exportación: en 2024 concentró el 84% del volumen total despachado desde este establecimiento.
          </p>
          <p class="font-sans text-[0.68rem] font-medium tracking-[0.1em] uppercase text-carbon">GACC · Registro activo</p>
        </div>
        <div class="bg-white p-10 border-t-2 border-[#c8a87a]">
          <p class="font-sans text-[0.58rem] tracking-[0.22em] uppercase text-[#8a6a3a] mb-4">Mercado 02</p>
          <h3 class="font-serif text-[1.4rem] font-light text-carbon mb-3">Estados Unidos</h3>
          <p class="font-sans text-[0.78rem] font-light text-[#555] leading-[1.8] mb-4">
            Habilitación para acceso al mercado norteamericano bajo los protocolos del Departamento de Agricultura (USDA). Uno de los mercados de mayor valor unitario para cortes premium.
          </p>
          <p class="font-sans text-[0.68rem] font-medium tracking-[0.1em] uppercase text-carbon">USDA · Habilitado</p>
        </div>
        <div class="bg-white p-10 border-t-2 border-[#c8a87a]">
          <p class="font-sans text-[0.58rem] tracking-[0.22em] uppercase text-[#8a6a3a] mb-4">Mercado 03</p>
          <h3 class="font-serif text-[1.4rem] font-light text-carbon mb-3">Unión Europea</h3>
          <p class="font-sans text-[0.78rem] font-light text-[#555] leading-[1.8] mb-4">
            Habilitación UE vigente. Uruguay cumple la normativa europea sobre deforestación y sustentabilidad que restringe el acceso a competidores de otras regiones, asegurando continuidad de suministro al mercado europeo.
          </p>
          <p class="font-sans text-[0.68rem] font-medium tracking-[0.1em] uppercase text-carbon">EU Approval · Vigente</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hito institucional -->
  <section class="bg-off-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-16 items-center">
      <div>
        <SectionLabel class="mb-4">Marzo 2026 · Un hito del grupo</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-6">
          La reinauguración que confirma la escala del proyecto
        </h2>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8] mb-4">
          El 13 de marzo de 2026, el Establecimiento Florida 365 fue reinaugurado bajo la dirección de Grupo Saturno con la presencia del Presidente de la República, Yamandú Orsi, autoridades nacionales y departamentales, y delegaciones comerciales de China y Estados Unidos.
        </p>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8]">
          La participación de delegaciones de los dos principales mercados de destino en el acto de apertura no fue protocolar: hay conversaciones activas de exportación. Para el comprador internacional, eso es la señal más clara de seriedad operativa.
        </p>
        <div class="mt-8 flex flex-col gap-4">
          {[
            'Inauguración con presencia del Presidente de la República',
            'Delegaciones comerciales de China y EE.UU. en el acto',
            '100 empleos directos en la fase inicial',
            'Capacidad proyectada: hasta 300 vacunos por día',
          ].map(item => (
            <div class="flex items-start gap-3 border-l-2 border-burgundy pl-4 py-1">
              <span class="font-sans text-[0.8rem] font-light text-[#444] leading-[1.7]">{item}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="space-y-2">
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src="/images/reapertura/reapertura-exterior-01.jpg"
            alt="Reinauguración Establecimiento Florida 365 — Grupo Saturno, marzo 2026"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <p class="font-sans text-[0.65rem] text-[#999] tracking-[0.1em] uppercase">
          Ceremonia de reinauguración · Marzo 2026 · Florida, Uruguay
        </p>
      </div>
    </div>
  </section>

  <!-- Teaser Evento Reapertura -->
  <section class="bg-carbon py-20 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative h-72 lg:h-auto overflow-hidden">
          <img
            src="/images/reapertura/reapertura-exterior-01.jpg"
            alt="Ceremonia de reapertura Frigorífico Florida, abril 2026"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-transparent to-carbon/60 hidden lg:block"></div>
        </div>
        <div class="bg-[#0e1215] p-10 lg:p-16 flex flex-col justify-center">
          <p class="font-sans text-[0.58rem] tracking-[0.25em] uppercase text-burgundy mb-4 flex items-center gap-3">
            <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
            Abril 2026
          </p>
          <h2 class="font-serif text-[clamp(1.6rem,2.2vw,2.2rem)] font-light text-white leading-[1.1] tracking-[-0.02em] mb-5">
            Reapertura del<br /><em class="italic text-white/70">Establecimiento Florida</em>
          </h2>
          <p class="font-sans text-[0.78rem] font-light text-white/50 leading-[1.75] mb-8 max-w-sm">
            En abril de 2026 celebramos un hito en la historia del grupo con la reapertura de la planta, reuniendo autoridades, colaboradores y socios estratégicos.
          </p>
          <a
            href={`/${lang}/EventoReobertura`}
            class="inline-flex items-center gap-3 font-sans text-[0.68rem] tracking-[0.12em] uppercase text-white/70 border border-white/20 px-6 py-3 w-fit hover:text-white hover:border-white/50 hover:bg-burgundy/30 transition-all duration-200"
          >
            Ver galería del evento <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactoComercial />

</SubLandingLayout>
