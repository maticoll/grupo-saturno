---
import SubLandingLayout from '../../layouts/SubLandingLayout.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import ContactoComercial from '../../components/sections/ContactoComercial.astro';
import { getLangFromUrl, useTranslations, languages } from '../../i18n/index';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<SubLandingLayout
  title={t('meta.floridaTitle')}
  description={t('meta.floridaDesc')}
  image="/images/florida/florida-exterior-01.jpg"
  unitName="Frigorífico Florida"
>

  <!-- JSON-LD FoodEstablishment -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FoodEstablishment",
    "name": "Frigorífico Florida — Establecimiento 365",
    "parentOrganization": { "@type": "Organization", "name": "Grupo Saturno" },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Florida",
      "addressRegion": "Florida",
      "addressCountry": "UY"
    },
    "description": "Planta frigorífica especializada en procesamiento y exportación de carne vacuna de calidad premium. Unidad 01 de Grupo Saturno.",
    "url": "https://gruposaturno.com.uy/es/FrigorificoFlorida"
  }).replace(/<\//g, '<\\/')} />

  <!-- Hero -->
  <section class="relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
    <img
      src="/images/florida-planta-exterior.jpg"
      alt="Establecimiento Florida 365, Grupo Saturno — Florida, Uruguay"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-carbon/90 via-carbon/40 to-carbon/10" aria-hidden="true"></div>
    <div class="relative z-10 max-w-[1440px] mx-auto px-8 lg:px-20 pb-16 w-full">
      <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-4 flex items-center gap-3">
        <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
        Unidad 01 · Grupo Saturno
      </p>
      <h1 class="font-serif text-[clamp(2.5rem,5vw,4.5rem)] font-light leading-[1.0] tracking-[-0.02em] text-white">
        Frigorífico Florida
      </h1>
      <p class="mt-4 font-sans text-[0.8rem] font-light text-white/60 max-w-lg leading-[1.75]">
        Establecimiento especializado en procesamiento y exportación de carne vacuna. Florida, Uruguay.
      </p>
    </div>
  </section>

  <!-- Capacidades -->
  <section class="bg-off-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <SectionLabel class="mb-4">Presentación</SectionLabel>
        <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-6">
          Especialización y capacidad de escala
        </h2>
        <p class="font-sans text-[0.85rem] font-light text-[#555] leading-[1.8]">
          El Establecimiento Florida 365 es la planta de faena propia de Grupo Saturno, adquirida en 2025 y reinaugurada en marzo de 2026. Con habilitaciones activas para exportar a China, Estados Unidos y la Unión Europea, es el eslabón que completa la integración vertical del grupo: del campo al contenedor, sin intermediarios.
        </p>
        <div class="mt-10 grid grid-cols-2 gap-px bg-burgundy/10">
          {[
            { label: 'Capacidad', value: '300 vacunos / día' },
            { label: 'Empleos directos', value: '+100 trabajadores' },
            { label: 'Exportaciones 2024', value: 'US$ 6,26 millones' },
            { label: 'Habilitaciones', value: 'GACC · USDA · UE' },
          ].map(({ label, value }) => (
            <div class="bg-off-white p-5">
              <p class="font-sans text-[0.58rem] tracking-[0.18em] uppercase text-burgundy mb-1">{label}</p>
              <p class="font-sans text-[0.82rem] font-medium text-carbon">{value}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-1 gap-2">
        <div class="aspect-[16/9] overflow-hidden">
          <img
            src="/images/florida-entrada.jpg"
            alt="Entrada Establecimiento Florida — Grupo Saturno, Florida, Uruguay"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/linea-procesado-2.jpg"
              alt="Línea de procesado — Frigorífico Florida, Grupo Saturno"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/packaging-vacuum-2.jpg"
              alt="Cortes vacunos al vacío — Frigorífico Florida, Grupo Saturno"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tres mercados -->
  <section class="bg-white py-24 px-8 lg:px-20">
    <div class="max-w-[1440px] mx-auto">
      <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-4 flex items-center gap-3">
        <span class="w-5 h-px bg-burgundy inline-block" aria-hidden="true"></span>
        Habilitaciones de exportación
      </p>
      <h2 class="font-serif text-[clamp(1.8rem,2.5vw,2.5rem)] font-light tracking-[-0.025em] text-carbon mb-12">
        Tres mercados. Tres estándares.<br /><em class="italic text-carbon/60">Un solo proveedor.</em>
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-burgundy/10">
        {[
          {
            flag: '🇨🇳',
            market: 'China',
            cert: 'GACC — Administración General de Aduanas',
            stat: '84% de las exportaciones 2024',
            text: 'China es el principal destino de Florida 365. En 2024 se exportaron US$ 5,26 millones al mercado chino. La empresa participó en la Feria SIAL Shanghai y mantiene contacto activo con importadores y delegaciones comerciales chinas.',
          },
          {
            flag: '🇺🇸',
            market: 'Estados Unidos',
            cert: 'USDA — Departamento de Agricultura',
            stat: 'Habilitación activa',
            text: 'El mercado norteamericano exige los protocolos sanitarios más estrictos del mundo. Florida 365 cuenta con habilitación USDA vigente, lo que permite exportar cortes premium directamente a importadores y distribuidores en EE.UU.',
          },
          {
            flag: '🇪🇺',
            market: 'Unión Europea',
            cert: 'Habilitación UE — bienestar animal y trazabilidad',
            stat: 'Habilitación activa',
            text: 'Europa exige máxima trazabilidad, bienestar animal y ausencia de hormonas de crecimiento. Uruguay cumple y supera todos estos requisitos. Florida 365 está habilitado para exportar a los 27 países del bloque.',
          },
        ].map(({ flag, market, cert, stat, text }) => (
          <div class="bg-white p-8 lg:p-10">
            <p class="text-3xl mb-4">{flag}</p>
            <p class="font-sans text-[0.58rem] tracking-[0.18em] uppercase text-burgundy mb-1">{cert}</p>
            <h3 class="font-serif text-[1.4rem] font-light text-carbon mb-1">{market}</h3>
            <p class="font-sans text-[0.68rem] font-medium text-burgundy mb-4">{stat}</p>
            <p class="font-sans text-[0.8rem] font-light text-[#555] leading-[1.75]">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactoComercial />

</SubLandingLayout>
