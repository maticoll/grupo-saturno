---
import '../styles/global.css';
// Fuentes chinas self-hosted (@fontsource) — Google Fonts está bloqueado en China.
// Solo se descargan en páginas /zh/ porque la font-family se aplica en html[lang='zh'].
import '@fontsource/noto-sans-sc/300.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-serif-sc/300.css';
import '@fontsource/noto-serif-sc/400.css';
import { getLangFromUrl, useTranslations, languages } from '../i18n/index';
import type { Lang } from '../i18n/index';

export interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
}

const { title, description, image = '/og-default.jpg' } = Astro.props;
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const keywords = Astro.props.keywords ?? t('meta.keywords');

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const hreflangs = languages.map(l => ({
  lang: l === 'zh' ? 'zh-CN' : l,
  href: new URL(`/${l}${Astro.url.pathname.replace(/^\/(es|en|zh)/, '')}`, Astro.site).href,
}));

const ogLocales: Record<string, string> = { es: 'es_UY', en: 'en_US', zh: 'zh_CN' };
const ogImageURL = new URL(image, Astro.site).href;
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Grupo Saturno" />
  <meta name="geo.region" content="UY-CA" />
  <meta name="geo.placename" content="Empalme Olmos, Canelones, Uruguay" />
  <meta name="theme-color" content="#1a1a1a" />
  <!-- Baidu: indica que el sitio sirve tanto desktop como mobile -->
  <meta name="applicable-device" content="pc,mobile" />
  <link rel="canonical" href={canonicalURL} />

  {hreflangs.map(({ lang: l, href }) => (
    <link rel="alternate" hreflang={l} href={href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL('/es/', Astro.site).href} />

  <!-- Open Graph -->
  <meta property="og:site_name" content="Grupo Saturno" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={ogLocales[lang]} />
  {languages.filter(l => l !== lang).map(l => (
    <meta property="og:locale:alternate" content={ogLocales[l]} />
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Schema.org Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://gruposaturno.uy/#organization",
    "name": "Grupo Saturno",
    "url": "https://gruposaturno.uy",
    "logo": "https://gruposaturno.uy/favicon.svg",
    "image": "https://gruposaturno.uy/og-default.jpg",
    "knowsLanguage": ["es", "en", "zh-CN"],
    "sameAs": [
      "https://www.linkedin.com/company/grupo-saturno",
      "https://frigorificosaturno.com.uy"
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ruta 8 Km 38",
      "addressLocality": "Empalme Olmos",
      "addressRegion": "Canelones",
      "addressCountry": "UY"
    },
    "foundingDate": "1990",
    "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 50 },
    "areaServed": ["UY", "CN", "BR", "AR", "US", "EU"],
    "description": "Empresa uruguaya con 36 años de trayectoria en producción ganadera, procesamiento frigorífico y comercialización internacional de carne vacuna.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Cortes vacunos premium — exportación e importación"
    }
  }).replace(/<\//g, '<\\/')} />

  <!-- Schema.org WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://gruposaturno.uy/#website",
    "name": "Grupo Saturno",
    "url": "https://gruposaturno.uy",
    "inLanguage": ["es", "en", "zh-CN"],
    "publisher": { "@id": "https://gruposaturno.uy/#organization" }
  }).replace(/<\//g, '<\\/')} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Preload fuentes críticas -->
  <link rel="preload" as="font" type="font/woff2"
    href="/fonts/ITCBlair-Light.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2"
    href="/fonts/ITCBlair-Medium.woff2" crossorigin />
  <!-- Noto SC self-hosted via @fontsource (importado arriba) — Google Fonts está bloqueado en China -->

</head>
<body>
  <slot />
  <script>
    // Scroll reveal con IntersectionObserver — agrega Y remueve 'revealed' para replay
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
          } else {
            e.target.classList.remove('revealed');
          }
        }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.scroll-reveal, .drop-reveal').forEach(el => observer.observe(el));

      // Count-up con replay: resetea al salir, anima al entrar
      const countUpObserver = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          const el = e.target;
          const raw = el.dataset.countUp;
          if (!e.isIntersecting) {
            el.textContent = raw;
            return;
          }
          const match = raw.match(/^(\d[\d.,]*)(.*)$/);
          if (!match) return;
          const target = parseFloat(match[1].replace(',', '.'));
          const suffix = match[2] || '';
          const duration = 700;
          const startTime = performance.now();
          const version = Date.now();
          el._countVersion = version;
          const tick = (now) => {
            if (el._countVersion !== version) return;
            const progress = Math.min((now - startTime) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (progress < 1) requestAnimationFrame(tick);
            else el.textContent = raw;
          };
          requestAnimationFrame(tick);
        }),
        { threshold: 0.5 }
      );
      document.querySelectorAll('[data-count-up]').forEach(el => countUpObserver.observe(el));
    }
  </script>
</body>
</html>
