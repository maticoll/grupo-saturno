---
import SectionLabel from '../ui/SectionLabel.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/index';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cutCategories = JSON.parse(t('product.cutsFullCategories')) as Array<{title: string; items: string[]}>;
---
<section class="bg-cream py-28 px-8 lg:px-20">
  <div class="max-w-[1440px] mx-auto">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end mb-16 scroll-reveal">
      <div>
        <SectionLabel class="mb-4">{t('product.label')}</SectionLabel>
        <h2 class="font-serif text-[clamp(2rem,2.8vw,2.8rem)] font-light tracking-[-0.025em] text-carbon leading-[1.05]">
          {t('product.h2').split(t('product.h2Italic'))[0]}
          <em class="italic">{t('product.h2Italic')}</em>
        </h2>
      </div>
      <p class="font-sans text-[0.78rem] font-light text-warm-gray leading-[1.7] max-w-sm lg:text-right mt-4 lg:mt-0">
        {t('product.subtitle')}
      </p>
    </div>

    <!-- Galeria editorial -->
    <div class="grid gap-1 mb-6 scroll-reveal"
      style="grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: 280px 200px">

      <!-- Imagen principal: camara frigorifica -->
      <div class="row-span-2 relative overflow-hidden group">
        <img
          src="/images/camara-frio-panoramica.jpg"
          alt="Camara frigorifica Grupo Saturno - capacidad de escala, Empalme Olmos, Uruguay"
          class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.04]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon/60 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 px-5 py-4">
          <span class="font-sans text-[0.6rem] tracking-[0.15em] uppercase text-white/70">
            Planta - Camara frigorifica
          </span>
        </div>
      </div>

      <!-- Instalaciones -->
      <div class="relative overflow-hidden group">
        <img
          src="/images/planta/planta-exterior-02.jpg"
          alt="Instalaciones Frigorifico Saturno - Empalme Olmos, Uruguay"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon/60 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 px-4 py-3">
          <span class="font-sans text-[0.6rem] tracking-[0.15em] uppercase text-white/70">Instalaciones - Planta propia</span>
        </div>
      </div>

      <!-- Linea de procesado -->
      <div class="relative overflow-hidden group">
        <img
          src="/images/linea-procesado.jpg"
          alt="Linea de procesado - operarios Establecimiento Florida 365, Grupo Saturno"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon/60 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 px-4 py-3">
          <span class="font-sans text-[0.6rem] tracking-[0.15em] uppercase text-white/70">Proceso - Linea de produccion</span>
        </div>
      </div>

      <!-- Presentacion boxed beef -->
      <div class="relative overflow-hidden group">
        <img
          src="/images/presentacion-vacuum.jpg"
          alt="Cajas Beef365 Uruguay listas para exportacion - Grupo Saturno"
          class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.04]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon/60 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 px-4 py-3">
          <span class="font-sans text-[0.6rem] tracking-[0.15em] uppercase text-white/70">Presentacion - Boxed beef</span>
        </div>
      </div>

      <!-- Logistica -->
      <div class="relative overflow-hidden group">
        <img
          src="/images/carga-contenedor.jpg"
          alt="Logistica - flota refrigerada Grupo Saturno"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon/60 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 px-4 py-3">
          <span class="font-sans text-[0.6rem] tracking-[0.15em] uppercase text-white/70">Logistica - Exportacion</span>
        </div>
      </div>

    </div>

    <!-- Listado completo de cortes INAC (acordeon) -->
    <div class="bg-burgundy/10 scroll-reveal" x-data="{ open: false, cat: null }">
      <button
        type="button"
        @click="open = !open"
        :aria-expanded="open"
        class="w-full bg-cream px-9 py-6 min-h-[44px] flex items-center justify-between gap-4 text-left cursor-pointer"
      >
        <h3 class="font-serif text-[1.3rem] font-medium text-carbon">{t('product.cutsFullToggle')}</h3>
        <svg class="w-5 h-5 text-burgundy shrink-0 transition-transform duration-300" :class="open && 'rotate-180'"
          fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </button>

      <div x-show="open" x-cloak class="border-t border-burgundy/10">
        <div class="grid grid-cols-1 gap-px bg-burgundy/10">
          {cutCategories.map((category, i) => (
            <div class="bg-cream">
              <button
                type="button"
                @click={`cat = cat === ${i} ? null : ${i}`}
                :aria-expanded={`cat === ${i}`}
                class="w-full px-9 py-4 min-h-[44px] flex items-center justify-between gap-4 text-left cursor-pointer"
              >
                <span class="font-serif text-[1.05rem] font-medium text-carbon">{category.title}</span>
                <span class="flex items-center gap-3 shrink-0">
                  <span class="font-sans text-[0.7rem] text-warm-gray">{category.items.length} {t('product.cutsFullCountLabel')}</span>
                  <svg class="w-4 h-4 text-burgundy transition-transform duration-300" :class={`cat === ${i} && 'rotate-180'`}
                    fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </button>
              <ul x-show={`cat === ${i}`} x-cloak class="px-9 pb-6 columns-1 sm:columns-2 lg:columns-3 gap-x-10">
                {category.items.map((item) => (
                  <li class="font-sans text-[0.82rem] font-light text-[#555] leading-[1.6] py-1.5 break-inside-avoid border-b border-burgundy/5">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="bg-cream px-9 py-4 font-sans text-[0.65rem] tracking-[0.05em] text-warm-gray border-t border-burgundy/10">
          {t('product.cutsFullSource')}
        </p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  [x-cloak] { display: none !important; }
</style>
