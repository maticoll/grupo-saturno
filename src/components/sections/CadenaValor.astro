---
import { getLangFromUrl, useTranslations } from '../../i18n/index';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="trayectoria" class="bg-carbon overflow-hidden">
  <div class="max-w-[1440px] mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_420px]">

      <!-- Columna izquierda: statement -->
      <div class="px-8 lg:px-20 py-24 lg:py-28">
        <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-8 scroll-reveal">
          {t('chain.label')}
        </p>
        <h2 class="font-serif text-[clamp(2.2rem,3vw,3.4rem)] font-light leading-[1.05] tracking-[-0.03em] text-white scroll-reveal">
          {t('chain.h2')}<br />
          <em class="italic text-white/40">{t('chain.h2Italic')}</em>
        </h2>
      </div>

      <!-- Columna central: texto -->
      <div class="px-8 lg:px-16 py-24 lg:py-28 lg:border-l border-white/[0.06] scroll-reveal" style="transition-delay:80ms">
        <p class="font-sans text-[0.83rem] font-light text-white/50 leading-[1.95] mb-6">
          {t('chain.body1')}
        </p>
        <p class="font-sans text-[0.83rem] font-light text-white/50 leading-[1.95]">
          {t('chain.body2')}
        </p>
        <div class="mt-12 pt-8 border-t border-white/[0.07] flex flex-wrap gap-x-7 gap-y-3">
          {[t('chain.fact1'), t('chain.fact2'), t('chain.fact3')].map(fact => (
            <span class="font-sans text-[0.63rem] tracking-[0.16em] uppercase text-burgundy">
              {fact}
            </span>
          ))}
        </div>
      </div>

      <!-- Columna derecha: imagen -->
      <div class="relative h-72 lg:h-auto lg:border-l border-white/[0.06] overflow-hidden">
        <img
          src="/images/florida/florida-proceso-01.jpg"
          alt="Interior Establecimiento Florida 365 — planta de faena Grupo Saturno"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-carbon/60 to-carbon/10 lg:block hidden"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-carbon/50 to-transparent lg:hidden"></div>
      </div>

    </div>
  </div>
</section>
