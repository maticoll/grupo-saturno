---
import { getLangFromUrl, useTranslations } from '../../i18n/index';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="trayectoria" class="bg-carbon py-28 px-8 lg:px-20">
  <div class="max-w-[1440px] mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-32 items-start scroll-reveal">

      <!-- Izquierda: statement -->
      <div>
        <p class="font-sans text-[0.6rem] tracking-[0.22em] uppercase text-burgundy mb-8">
          {t('chain.label')}
        </p>
        <h2 class="font-serif text-[clamp(2.2rem,3.5vw,3.8rem)] font-light leading-[1.05] tracking-[-0.03em] text-white">
          {t('chain.h2')}<br />
          <em class="italic text-white/45">{t('chain.h2Italic')}</em>
        </h2>
      </div>

      <!-- Derecha: explicación -->
      <div class="lg:pt-20">
        <p class="font-sans text-[0.85rem] font-light text-white/55 leading-[1.9] mb-6">
          {t('chain.body1')}
        </p>
        <p class="font-sans text-[0.85rem] font-light text-white/55 leading-[1.9]">
          {t('chain.body2')}
        </p>

        <!-- Línea de hechos -->
        <div class="mt-14 pt-10 border-t border-white/[0.07] flex flex-wrap gap-x-8 gap-y-4">
          {[t('chain.fact1'), t('chain.fact2'), t('chain.fact3')].map(fact => (
            <span class="font-sans text-[0.65rem] tracking-[0.14em] uppercase text-burgundy">
              {fact}
            </span>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
