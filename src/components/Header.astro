---
import LanguageSelector from './LanguageSelector.astro';
import MobileMenu from './MobileMenu.astro';
import { getLangFromUrl, useTranslations } from '../i18n/index';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export interface Props {
  extraLogo?: { src: string; alt: string };
}
const { extraLogo } = Astro.props;
---
<header
  x-data="{ scrolled: false, _handler: null }"
  x-init="
    scrolled = window.scrollY > 20;
    _handler = () => { scrolled = window.scrollY > 20 };
    window.addEventListener('scroll', _handler, { passive: true });
  "
  x-destroy="window.removeEventListener('scroll', _handler)"
  :class="scrolled ? 'bg-cream/95 backdrop-blur-md shadow-sm' : 'bg-cream/95'"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-out"
>
  <div class="max-w-[1440px] mx-auto px-8 lg:px-20 h-16 flex items-center justify-between">

    <!-- Logo -->
    <div class="flex items-center gap-4 shrink-0">
      <a href={`/${lang}/`} aria-label="Grupo Saturno — inicio">
        <img
          src="/images/saturno-logo-texto.svg"
          alt="Grupo Saturno"
          class="h-28 w-auto"
        />
      </a>
      {extraLogo && (
        <>
          <span class="w-px h-8 bg-carbon/20" aria-hidden="true"></span>
          <img
            src={extraLogo.src}
            alt={extraLogo.alt}
            class="h-12 w-auto"
          />
        </>
      )}
    </div>

    <!-- Nav desktop -->
    <nav class="hidden lg:flex items-center gap-10" aria-label="Navegacion principal">

      <a href={`/${lang}/`}
        class="font-sans text-[0.72rem] tracking-[0.08em] uppercase text-carbon/60 hover:text-carbon transition-colors">
        {t('nav.group')}
      </a>

      <!-- Nuestras Unidades dropdown -->
      <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
        <button
          @click="open = !open"
          class="font-sans text-[0.72rem] tracking-[0.08em] uppercase text-carbon/60 hover:text-carbon transition-colors flex items-center gap-1"
          :aria-expanded="open.toString()"
        >
          {t('nav.units')}
          <svg class="w-3 h-3 transition-transform duration-200" :class="open ? 'rotate-180' : ''" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="2,4 6,8 10,4"/>
          </svg>
        </button>
        <div
          x-show="open"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          class="absolute top-full left-1/2 -translate-x-1/2 mt-3 bg-cream border border-burgundy/10 shadow-lg w-52 py-2"
        >
          <a href={`/${lang}/FrigorificoSaturno`}
            class="block px-5 py-3 font-sans text-[0.7rem] tracking-[0.06em] uppercase text-carbon/60 hover:text-carbon hover:bg-burgundy/5 transition-colors">
            {t('units.unit2Title')}
          </a>
          <a href={`/${lang}/EstablecimientoFlorida`}
            class="block px-5 py-3 font-sans text-[0.7rem] tracking-[0.06em] uppercase text-carbon/60 hover:text-carbon hover:bg-burgundy/5 transition-colors">
            {t('units.unit1Title')}
          </a>
        </div>
      </div>

      <a href={`/${lang}/EventoReApertura`}
        class="font-sans text-[0.72rem] tracking-[0.08em] uppercase text-carbon/60 hover:text-carbon transition-colors">
        {t('nav.history')}
      </a>

      <a href={`/${lang}/#contacto`}
        class="font-sans text-[0.68rem] font-medium tracking-[0.1em] uppercase text-burgundy border border-burgundy px-4 py-2 hover:bg-burgundy hover:text-white transition-all duration-200">
        {t('nav.ctaContact')}
      </a>

      <LanguageSelector />
    </nav>

    <MobileMenu />
  </div>
</header>
<div class="h-16" aria-hidden="true"></div>
