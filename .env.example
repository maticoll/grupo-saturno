# SMTP NTY — copiar a `.env` (en producción se sube junto a contacto.php
# dentro del dist/, o se setea en cPanel > Setup PHP > Environment Variables).
# Test local: `npm run build && php -S localhost:8000 -t dist` — ver README.

SMTP_HOST=s109.nty.uy
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

MAIL_FROM=
MAIL_FROM_NAME=Grupo Saturno - Web
MAIL_TO=
# Opcional. Si está vacío, no se agrega BCC.
MAIL_BCC=

# Dejar en false en producción. Si está en "true" el endpoint devuelve
# el log SMTP en la respuesta JSON — útil para diagnosticar, peligroso
# en prod porque expone detalles del servidor.
DEBUG_SMTP=false
